# =============================================================================
# Required — Microsoft Entra app registration (see README)
# =============================================================================
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret

# =============================================================================
# Required in production — Flask session secret
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Default if unset: change-me-in-production
# =============================================================================
SECRET_KEY=change-me-to-a-random-secret

# =============================================================================
# Optional — logging (default: INFO)
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# Optional — SMTP server identity (default: localhost)
# Used as the TLS certificate CN and in the SMTP banner
# =============================================================================
SMTP_HOSTNAME=smtp.example.com

# =============================================================================
# Optional — runtime data directory (default: /app/data)
# SQLite database and auto-generated TLS certs are stored here
# =============================================================================
DATA_DIR=/app/data

# =============================================================================
# Optional — maximum SMTP message size in megabytes (default: 35, minimum: 1)
# =============================================================================
MAX_MESSAGE_SIZE_MB=35

# =============================================================================
# Optional — custom TLS certificate for SMTP
# If both are set, auto-generation and auto-renewal are disabled.
# Mount the files into the container and set these paths accordingly.
# =============================================================================
# SMTP_CERT_FILE=/app/data/certs/custom.pem
# SMTP_KEY_FILE=/app/data/certs/custom.key

# =============================================================================
# Docker Secrets — any variable above can also be provided as <VAR>_FILE
# pointing to a file containing the value. Example:
# ENTRA_CLIENT_SECRET_FILE=/run/secrets/entra_client_secret
# =============================================================================
