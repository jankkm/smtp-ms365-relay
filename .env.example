# Microsoft Entra (Azure AD) app registration
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret

# Flask session secret key - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# Hostname used as TLS certificate CN and in SMTP banner
SMTP_HOSTNAME=smtp.example.com

# Directory for SQLite database and TLS certificates (inside container)
DATA_DIR=/app/data

# Optional: paths to a custom TLS certificate and key for the SMTP server.
# If both are set, auto-generation and auto-renewal are disabled.
# Mount the files into the container and set these paths accordingly.
# SMTP_CERT_FILE=/app/data/certs/custom.pem
# SMTP_KEY_FILE=/app/data/certs/custom.key

# Docker Secrets alternative: any variable above can also be provided as <VAR>_FILE
# pointing to a file containing the value. Example:
# ENTRA_CLIENT_SECRET_FILE=/run/secrets/entra_client_secret
